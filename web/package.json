{
  "name": "cloud-harness-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "test": "tsx scripts/test-sse.ts && tsx scripts/test-sse-http.ts && tsx scripts/test-events.ts && tsx scripts/test-timeline.ts && tsx scripts/test-observability.ts && tsx scripts/test-proxy.ts && tsx scripts/test-session-history.ts && tsx scripts/test-session-history-http.ts && npm run test:session-restore",
    "test:sse-http": "tsx scripts/test-sse-http.ts",
    "test:session-history": "tsx scripts/test-session-history.ts",
    "test:session-history-http": "tsx scripts/test-session-history-http.ts",
    "check:dist": "bash scripts/check-dist.sh",
    "preview": "vite preview",
    "test:session-restore": "tsx --tsconfig tsconfig.app.json scripts/test-session-restore.tsx"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "selenium-webdriver": "^4.51.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
